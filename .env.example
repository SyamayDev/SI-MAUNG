# Copy to .env.local and fill in from Supabase → Project Settings → API.
# These are PUBLIC client settings (they end up in the browser bundle).
# Never put a service_role key or any AI provider key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: "true" lets the app call the parse-transaction Edge Function when
# the on-device parser cannot read a sentence. Leave empty until the function
# is deployed with its OPENAI_API_KEY secret (see docs/SUPABASE.md).
VITE_ENABLE_AI_PARSER=

# Optional: base path. Leave EMPTY — GitHub Pages (npm run deploy) always uses
# /SI-MAUNG/ and Vercel uses / automatically.
VITE_BASE_PATH=

# Optional: public address used in link previews / canonical / sitemap.
# Leave empty: Vercel's production domain or the GitHub Pages URL is used.
VITE_SITE_URL=
